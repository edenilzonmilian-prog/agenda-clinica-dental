{
  "info": {
    "name": "PF12 - Agenda de Clínica Dental",
    "description": "Ejecutar en orden en una base de prueba. Cambiar la fecha/hora si ya fueron utilizados por una ejecución previa. Los ID de nuevas entidades se guardan automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Listar tratamientos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tratamientos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear tratamiento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tratamientos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba Postman\",\n  \"descripcion\": \"Tratamiento de demostración\",\n  \"precio\": 125.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"tratamientoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
